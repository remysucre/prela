    urldate = {2026-11-16},
    abstract = {In this chapter we present the class of fork algebras, an
                extension of relation algebras with an extra operator called
                fork. We will present results relating fork algebras both to
                logic and to computer science. The interpretability of
                first-order theories as equational theories in fork algebras will
                provide a tool for expressing program specifications as fork
                algebra equations. Furthermore, the finite axiomatizability of
                this class of algebras will be shown to have deep influence in
                the process of program development within a relational calculus
                based on fork algebras.},
    isbn = {978-3-7091-6510-2},
