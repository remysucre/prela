cabal-version:      3.0
name:               prela
version:            0.1.0
synopsis:           Prela — Tarski algebra-of-relations query language, Haskell port
build-type:         Simple

library
    exposed-modules:  Prela
    hs-source-dirs:   src
    build-depends:    base >=4.14, containers
    default-language: Haskell2010
    ghc-options:      -Wall

executable prela-demo
    main-is:          Demo.hs
    hs-source-dirs:   app
    build-depends:    base >=4.14, prela
    default-language: Haskell2010
    ghc-options:      -Wall
