cabal-version:      3.0
name:               prela
version:            0.1.0
synopsis:           Prela — Tarski algebra-of-relations query language, Haskell port
build-type:         Simple

library
    exposed-modules:  Prela.Id
                    , Prela.Storage
                    , Prela.Cache
                    , Prela.Schema
                    , Prela.PullStaged.Stream
                    , Prela.PullStaged.Ops
                    , Prela.PullStaged.Query
    other-modules:    Prela.Storage.Internal
                    , Prela.Id.Internal
                    , Prela.PullStaged.Stream.Internal
                    , Prela.PullStaged.Scalar
                    , Prela.PullStaged.Relation
                    , Prela.PullStaged.Generation
                    , Prela.PullStaged.Predicate
                    , Prela.PullStaged.Materialize
                    , Prela.PullStaged.Consumer
    hs-source-dirs:   src
    build-depends:    base >=4.14, containers, array, bytestring, regex-tdfa
                    , vector, template-haskell, hashable, filepath, mmap
    default-language: Haskell2010
    ghc-options:      -O2 -Wall

test-suite prela-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    other-modules:    TinyStaged, StagedQueries
    hs-source-dirs:   test
    build-depends:    base >=4.14, prela, bytestring, directory
                    , filepath, template-haskell, vector
    default-language: Haskell2010
    ghc-options:      -O2 -Wall

-- The TPC-H suite: schema, the 22 queries, and the runner that checks each
-- against its oracle. Needs a cache built by the Rust regen tool — see
-- ../benchmarking.md.
executable prela-tpch
    main-is:          Main.hs
    other-modules:    TPCH.Decl
                    , TPCH.Oracles
                    , TPCH.StagedSchema
                    , TPCH.StagedQueries
                    , TPCH.Staged
    hs-source-dirs:   tpch
    build-depends:    base >=4.14, prela, bytestring, filepath, vector
    default-language: Haskell2010
    ghc-options:      -O2 -Wall
