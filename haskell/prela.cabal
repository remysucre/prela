cabal-version:      3.0
name:               prela
version:            0.1.0
synopsis:           Prela — Tarski algebra-of-relations query language, Haskell port
build-type:         Simple

library
    exposed-modules:  Prela.Id
                    , Prela.Storage
                    , Prela.Cache
                    , Prela.Schema
                    , Prela.PullStaged
                    , Prela.PullStaged.Stream
                    , Prela.PullStaged.Ops
                    , Prela.PullStaged.Predicate
                    , Prela.PullStaged.Materialize
                    , Prela.Pull
                    , Prela.Pull.Stream
                    , Prela.Pull.Ops
                    , Prela.Pull.Predicate
                    , Prela.Pull.Materialize
    hs-source-dirs:   src
    build-depends:    base >=4.14, containers, array, bytestring, regex-tdfa
                    , vector, template-haskell, hashable, filepath
    default-language: Haskell2010
    ghc-options:      -Wall

test-suite prela-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    other-modules:    TinyStaged, StagedQueries
    hs-source-dirs:   test
    build-depends:    base >=4.14, prela, bytestring, containers, directory
                    , filepath, template-haskell, vector
    default-language: Haskell2010
    ghc-options:      -Wall

executable prela-demo-pull
    main-is:          PullDemo.hs
    hs-source-dirs:   app
    build-depends:    base >=4.14, prela
    default-language: Haskell2010
    ghc-options:      -Wall

-- The TPC-H suite: schema, the 22 queries, and the runner that checks each
-- against its oracle. Needs a cache built by the Rust regen tool — see
-- ../benchmarking.md.
executable prela-tpch
    main-is:          Main.hs
    other-modules:    TPCH.Decl
                    , TPCH.Oracles
                    , TPCH.StagedSchema
                    , TPCH.StagedQueries
                    , TPCH.Staged
    hs-source-dirs:   tpch
    build-depends:    base >=4.14, prela, bytestring, containers, directory
                    , filepath, template-haskell, vector
    default-language: Haskell2010
    ghc-options:      -Wall -O2
